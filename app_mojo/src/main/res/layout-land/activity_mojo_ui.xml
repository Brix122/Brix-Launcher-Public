<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/brix_page">
 <LinearLayout android:id="@+id/brix_topbar" android:layout_width="0dp" android:layout_height="54dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="14dp" android:background="@color/brix_header" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
  <ImageView android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/brix_bl_logo" android:padding="3dp" android:contentDescription="BL logo" android:scaleType="fitCenter" android:adjustViewBounds="true" android:clipToOutline="false" android:cropToPadding="false"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="BRIX" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/brix_accent"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" LAUNCHER" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/brix_text"/>
  <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
  <ImageButton android:id="@+id/brix_theme_button" android:layout_width="43dp" android:layout_height="43dp" android:layout_marginEnd="8dp" android:background="@drawable/brix_final_tile" android:src="@drawable/brix_theme_icon" android:contentDescription="Switch light and dark theme" android:padding="8dp"/>
  <com.kdt.mcgui.AccountSpinner android:id="@+id/account_spinner" android:layout_width="160dp" android:layout_height="44dp" android:dropDownWidth="wrap_content" android:dropDownVerticalOffset="44dp" android:background="@drawable/brix_final_tile" android:textColor="@color/brix_text"/>
  <ImageButton android:id="@+id/setting_button" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/brix_final_settings" android:background="@drawable/brix_final_tile" android:contentDescription="Settings or back"/>
 </LinearLayout>
 <View android:layout_width="0dp" android:layout_height="2dp" android:background="@color/brix_accent" app:layout_constraintTop_toBottomOf="@id/brix_topbar" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
 <androidx.fragment.app.FragmentContainerView android:id="@+id/container_fragment" android:name="git.artdeell.mojo.fragments.MainMenuFragment" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toBottomOf="@id/brix_topbar" app:layout_constraintBottom_toTopOf="@id/progress_layout" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
 <com.kdt.mcgui.ProgressLayout android:id="@+id/progress_layout" android:layout_width="0dp" android:layout_height="wrap_content" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
