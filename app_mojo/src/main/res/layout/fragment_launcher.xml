<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#07080B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/brix_dark_surface"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PREMIUM BRIX"
                android:textColor="#FF2234"
                android:textStyle="bold"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Launch faster. Look cleaner. Play better."
                android:textColor="@color/brix_text"
                android:textStyle="bold"
                android:textSize="24sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Hyper-style premium BRIX home with quick actions, profile launch and a cleaner dark workspace."
                android:textColor="#A8ADBA"
                android:textSize="13sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="QUICK ACTIONS"
            android:textColor="@color/brix_text"
            android:textStyle="bold"
            android:textSize="15sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/brix_dark_surface"
            android:padding="12dp">

            <Button android:id="@+id/custom_control_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:background="@drawable/brix_dark_stroke" android:text="Custom Controls" android:textAllCaps="false" android:textColor="@color/brix_text"/>
            <Button android:id="@+id/install_jar_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:background="@drawable/brix_dark_stroke" android:text="Install / Execute .jar" android:textAllCaps="false" android:textColor="@color/brix_text"/>
            <Button android:id="@+id/open_files_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:background="@drawable/brix_dark_stroke" android:text="Open Game Directory" android:textAllCaps="false" android:textColor="@color/brix_text"/>
            <Button android:id="@+id/share_logs_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:background="@drawable/brix_dark_stroke" android:text="Share Log File" android:textAllCaps="false" android:textColor="@color/brix_text"/>
            <Button android:id="@+id/news_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:background="@drawable/brix_dark_stroke" android:text="Official Source" android:textAllCaps="false" android:textColor="@color/brix_text"/>
            <Button android:id="@+id/social_media_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:background="@drawable/brix_dark_stroke" android:text="Community" android:textAllCaps="false" android:textColor="@color/brix_text"/>
            <Button android:id="@+id/credits_button" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/brix_dark_stroke" android:text="Credits" android:textAllCaps="false" android:textColor="@color/brix_text"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/brix_dark_surface"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT VERSION"
                android:textColor="#FF2234"
                android:textStyle="bold"
                android:textSize="12sp"/>

            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/brix_dark_stroke"
                android:drawableEnd="@drawable/spinner_arrow"
                android:textColor="@color/brix_text"
                app:drawableEndPadding="4dp"
                app:drawableEndSize="12dp"
                app:drawableStartIntegerScaling="true"
                app:drawableStartSize="36dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/edit_profile_button"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/brix_premium_icon_btn"
                    android:contentDescription="Edit profile"
                    android:padding="14dp"
                    android:src="@drawable/ic_px_edit"/>

                <Button
                    android:id="@+id/play_button"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/brix_premium_red"
                    android:text="PLAY"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
